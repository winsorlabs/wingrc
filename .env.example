# Copy to .env and adjust. Never commit real secrets.
WINGRC_DATABASE_URL=postgresql+psycopg://wingrc:wingrc@localhost:5432/wingrc

# "development" or "production". This is the ONLY thing that flips the
# session cookie's Secure flag on (see backend/app/auth.py) — there is no
# separate cookie-secure env var. Set to "production" for ANY deployment
# served over HTTPS/a real domain, including self-hosted single-tenant
# instances; leave "development" only for local/LAN work without TLS.
WINGRC_ENVIRONMENT=development

# AI provider abstraction (not used by the scope module yet):
#   none | anthropic | azure_openai | local
WINGRC_AI_PROVIDER=none
# ANTHROPIC_API_KEY=

# S3-compatible object storage (MinIO in dev).
# storage_endpoint is the internal Docker endpoint the backend uses to reach MinIO.
# storage_public_endpoint is the address browsers use to reach MinIO —
# required when the backend runs in Docker and the browser runs on a different host.
# Without this, presigned URLs contain the internal 'minio' hostname (ERR_NAME_NOT_RESOLVED).
#
# Behind the nginx reverse proxy (see docs/deployment.md), this must be the
# dedicated storage subdomain over HTTPS, e.g. https://storage.YOUR_HOSTNAME —
# NOT a path under the main app hostname (MinIO's bucket routing needs the
# unprefixed path, so a path prefix breaks presigned-URL signature
# validation; see deploy/nginx/nginx.conf for the full explanation).
# For LAN-only dev without the proxy, a bare LAN IP:9000 still works, e.g.
# http://10.10.24.35:9000.
# WINGRC_STORAGE_ENDPOINT=http://minio:9000
# WINGRC_STORAGE_PUBLIC_ENDPOINT=https://storage.YOUR_HOSTNAME
# WINGRC_STORAGE_ACCESS_KEY=wingrc
# WINGRC_STORAGE_SECRET_KEY=wingrc-dev-secret
# WINGRC_STORAGE_BUCKET=evidence

# MinIO's own public URL (set only when nginx fronts it in production) — see
# docker-compose.yml comment on the minio service.
# MINIO_SERVER_URL=https://storage.YOUR_HOSTNAME

# Encrypts third-party integration credentials at rest (D.1 — Liongard's
# API key first). REQUIRED before configuring any integration; backend/app/
# crypto.py fails closed with this unset, refusing to store or read a
# credential rather than falling back to plaintext.
#
# Lives outside the database by design (that's the security property) — a
# database backup alone will NOT restore decryption. Store this value
# (the whole "label:key", not just the key) somewhere durable — your
# password manager, alongside Postgres/MinIO secrets — before it's load-
# bearing. Loss is unrecoverable: no reset, no backdoor, only re-entering
# every credential by hand. Rotate with `wingrc rotate-credential-keys`.
#
# Format:
# "label:fernetkey[,label2:fernetkey2,...]" — first entry is used for new
# encryptions; keep old labels around after rotating in a new primary so
# credentials encrypted under them keep decrypting (see crypto.py's module
# docstring). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# docker-compose.yml ships a dev-only key as its own default — override it
# here for anything beyond local/bench use, and never commit a real one.
# WINGRC_CREDENTIAL_ENCRYPTION_KEYS=prod:PASTE_A_GENERATED_FERNET_KEY_HERE

# The browser-facing URL for this deployment — the backend has no other way
# to know it (nginx terminates the real hostname; there's no request in
# scope when building an invite/reset-password email). Used only to build
# the link in those two emails (backend/app/routers/users.py); the SMTP
# connector itself is configured at runtime via Administration -> Email,
# not through an env var, same as the Liongard connector (the credential
# lives encrypted in the database via crypto.py, not here). Leave unset and
# invite/reset still work — the admin delivers the returned token by hand
# instead of an emailed link; see email_service.py's module docstring.
# WINGRC_PUBLIC_URL=https://YOUR_HOSTNAME
