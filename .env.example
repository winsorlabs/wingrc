# Copy to .env, then fill the secrets:
#
#   cp .env.example .env && chmod 600 .env && deploy/generate-env.sh
#
# Keep .env at mode 600 or 640: it holds every credential below. Never
# commit it. Store each generated value somewhere durable off this host
# (a password manager): losing WINGRC_CREDENTIAL_ENCRYPTION_KEYS loses every
# stored integration credential, and nothing recovers it.

# ── Required. docker compose refuses to start while any is empty, and
# names it. None has a default: the defaults this file and
# docker-compose.yml used to carry were public (docs/roadmap.md, "The
# compose file ships default credentials"). ──

# "production" or "development"; nothing else is accepted. production puts
# Secure on every cookie (backend/app/auth.py); use it for any deployment
# served over HTTPS. development is for local work without TLS, and is the
# only value under which `wingrc reset-dev` runs. Not generated: a decision.
WINGRC_ENVIRONMENT=

# The database owner's password. Read by Postgres only when its volume is
# first initialised; on an existing deployment change it with ALTER ROLE
# (docs/deployment.md, "Moving off a default credential").
POSTGRES_PASSWORD=

# The password of wingrc_app, the role requests are served as. Row-level
# security applies to it; it does not to the owner. The backend sets the
# role's password to this as it starts. URL-safe characters only.
WINGRC_APP_DB_PASSWORD=

# MinIO's root credentials, also read at first start only, and the
# backend's storage credentials, which today must equal them.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
WINGRC_STORAGE_ACCESS_KEY=
WINGRC_STORAGE_SECRET_KEY=

# Signs the sign-in state cookies; at least 32 characters.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WINGRC_AUTH_FLOW_SECRET=

# Encrypts stored integration credentials (Liongard, SMTP, the AI provider)
# at rest. "label:fernetkey[,label2:fernetkey2,...]"; the first entry
# encrypts, the rest only decrypt, so keep an old label after rotating in a
# new primary (backend/app/crypto.py; `wingrc rotate-credential-keys`).
# Lives outside the database on purpose: a database backup alone does not
# restore decryption. Generate a key with:
#   python3 -c "import base64,os; print('prod:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
WINGRC_CREDENTIAL_ENCRYPTION_KEYS=

# ── Optional ──

# The app's connection. Unset, compose connects as wingrc_app with
# WINGRC_APP_DB_PASSWORD above. Set it outright only to serve as another
# role; /health's database_role then says whether that role skips
# row-level security (docs/deployment.md, "Database roles").
# WINGRC_DATABASE_URL=postgresql+psycopg://wingrc_app:APP_PASSWORD@db:5432/wingrc

# Connection used ONLY by `alembic upgrade head` (app/migrations/env.py).
#
# Why two connection strings exist -- please read before consolidating them
# back into one, which is the obvious-looking tidy-up and the wrong move:
# running migrations and serving requests need different database
# privileges. Migrations need the table OWNER (they create and alter
# tables). The application serves as `wingrc_app`, a role that
# deliberately has no DDL rights and cannot bypass row-level security, so
# that a bug in a query cannot read another tenant's rows. One role cannot
# be both.
#
# Unset, compose builds it for the owner from POSTGRES_PASSWORD, which is
# right for a deployment that keeps compose's database service.
#
# It must name the same host, port and database as WINGRC_DATABASE_URL and
# differ only in the user -- migrating one database while the app serves
# another is refused rather than attempted.
#
# WINGRC_MIGRATION_DATABASE_URL=postgresql+psycopg://wingrc:OWNER_PASSWORD@db:5432/wingrc

# AI provider (used for AI-assisted document ingestion) is configured at
# runtime via Administration -> AI Provider, not through an env var, same
# as the Liongard and SMTP connectors -- the API key lives encrypted in the
# database via crypto.py, not here. No env var replaces it, and leaving it
# unconfigured is a supported, safe default: ingestion degrades to a clean
# 422 pointing back at Administration rather than failing. Only "anthropic"
# is implemented today; Azure OpenAI (GCC High) and a local-model backend
# are planned but not built yet -- see CLAUDE.md's BYO-AI note.

# S3-compatible object storage (MinIO in dev).
# storage_endpoint is the internal Docker endpoint the backend uses to reach MinIO.
# storage_public_endpoint is the address browsers use to reach MinIO —
# required when the backend runs in Docker and the browser runs on a different host.
# Without this, presigned URLs contain the internal 'minio' hostname (ERR_NAME_NOT_RESOLVED).
#
# Behind the nginx reverse proxy (see docs/deployment.md), this must be the
# dedicated storage subdomain over HTTPS, e.g. https://storage.YOUR_HOSTNAME —
# NOT a path under the main app hostname (MinIO's bucket routing needs the
# unprefixed path, so a path prefix breaks presigned-URL signature
# validation; see deploy/nginx/nginx.conf for the full explanation).
# For LAN-only dev without the proxy, a bare LAN IP:9000 still works, e.g.
# http://10.10.24.35:9000.
# WINGRC_STORAGE_ENDPOINT=http://minio:9000
# WINGRC_STORAGE_PUBLIC_ENDPOINT=https://storage.YOUR_HOSTNAME
# WINGRC_STORAGE_BUCKET=evidence

# MinIO's own public URL (set only when nginx fronts it in production) — see
# docker-compose.yml comment on the minio service.
# MINIO_SERVER_URL=https://storage.YOUR_HOSTNAME


# The browser-facing URL for this deployment — the backend has no other way
# to know it (nginx terminates the real hostname; there's no request in
# scope when building an invite/reset-password email). Used only to build
# the link in those two emails (backend/app/routers/users.py); the SMTP
# connector itself is configured at runtime via Administration -> Email,
# not through an env var, same as the Liongard connector (the credential
# lives encrypted in the database via crypto.py, not here). Leave unset and
# invite/reset still work — the admin delivers the returned token by hand
# instead of an emailed link; see email_service.py's module docstring.
# WINGRC_PUBLIC_URL=https://YOUR_HOSTNAME

# Memory limits for the backend and worker containers (docker-compose.yml,
# where the reasoning is). With a limit, a request or job that runs out of
# memory kills and restarts its own container; without one the host's OOM
# killer chooses, and it can choose Postgres. Swap is held to the same
# value. Raise them on a larger host; do not remove them.
# WINGRC_BACKEND_MEMORY=1536m
# WINGRC_WORKER_MEMORY=1g
