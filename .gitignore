# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
*.local

# Local dev override (see docker-compose.override.yml.example)
docker-compose.override.yml

# Node / frontend
node_modules/
frontend/dist/

# OS / editors
.DS_Store
.idea/
.vscode/

# Build / output artifacts
/dist/
*.xlsx
!samples/*.xlsx

# Deployment-host credential material. .env is already ignored above; these
# are the files the wingrc_app cutover leaves beside it on a deployment host
# (the generated role password, and the pre-cutover .env backup). Neither
# should ever be committable by an accidental `git add -A` on that host.
.wingrc_app_pw
.env.*.bak
.env.bak
