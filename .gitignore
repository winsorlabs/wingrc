# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
*.local

# Local dev override (see docker-compose.override.yml.example)
docker-compose.override.yml

